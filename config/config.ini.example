[DEFAULT]
# Set to true to load CONSUMER_KEY/SECRET from macOS Keychain instead of this file.
# Store credentials via CLI menu option "Store credentials in Keychain" first.
USE_KEYRING_ETRADEKEYS = false

PROD_BASE_URL=https://api.etrade.com
PROD_CONSUMER_KEY = xxx-key
PROD_CONSUMER_SECRET = xxx-secret

SANDBOX_BASE_URL=https://apisb.etrade.com
SANDBOX_CONSUMER_KEY = yyy-key
SANDBOX_CONSUMER_SECRET = yyy-secret

